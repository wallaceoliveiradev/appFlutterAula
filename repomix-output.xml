<file path="lib/src/screens/epi_detalhe_screen.dart">
import 'package:flutter/material.dart';

import '../models/epi.dart';
import '../models/usuario.dart';
import '../services/api_config.dart';
import '../services/emprestimo_service.dart';

class EpiDetalheScreen extends StatefulWidget {
  final Epi epi; // EPI escolhido na lista
  final Usuario usuario; // funcionário logado

  const EpiDetalheScreen({super.key, required this.epi, required this.usuario});

  @override
  State<EpiDetalheScreen> createState() => _EpiDetalheScreenState();
}

class _EpiDetalheScreenState extends State<EpiDetalheScreen> {
  final formKey = GlobalKey<FormState>();
  final observacaoController = TextEditingController();
  bool carregando = false;

  @override
  void dispose() {
    observacaoController.dispose();
    super.dispose();
  }

  Future<void> solicitarEmprestimo() async {
    if (!formKey.currentState!.validate()) return;

    final confirmar = await showDialog<bool>(
      context: context,
      builder: (context) => AlertDialog(
        title: const Text('Confirmar solicitação'),
        content: Text('Confirma a solicitação de "${widget.epi.nome}"?'),
        actions: [
          TextButton(
            onPressed: () => Navigator.pop(context, false),
            child: const Text('Cancelar'),
          ),
          ElevatedButton(
            onPressed: () => Navigator.pop(context, true),
            child: const Text('Confirmar'),
          ),
        ],
      ),
    );

    if (confirmar != true) return;

    setState(() {
      carregando = true;
    });
    try {
      // 2. Envia o POST
      await EmprestimoService().solicitar(
        funcionarioId: widget.usuario.id,
        epiId: widget.epi.id,
        observacao: observacaoController.text.trim(),
      );

      if (!mounted) return;

      // 3. Sucesso: avisa e volta para a lista
      ScaffoldMessenger.of(context).showSnackBar(
        const SnackBar(
          content: Text('Solicitação enviada! Aguarde a aprovacão.'),
          backgroundColor: Colors.green,
        ),
      );
      Navigator.pop(context);
    } catch (e) {
      if (!mounted) return;

      // 4. Erro: mostra a mensagem que veio da API
      ScaffoldMessenger.of(context).showSnackBar(
        SnackBar(
          content: Text(e.toString().replaceFirst('Exception: ', '')),
          backgroundColor: Colors.red,
        ),
      );
    } finally {
      if (mounted) {
        setState(() {
          carregando = false;
        });
      }
    }
  }

  @override
  Widget build(BuildContext context) {
    final epi = widget.epi;

    // 0 app só libera o botão se o EPI puder ser emprestado
    final podeSolicitar = !epi.caVencido && epi.quantidadeDisponivel > 0;

    return Scaffold(
      appBar: AppBar(
        title: const Text('Detalhes do EPI'),
        backgroundColor: Colors.blue,
        foregroundColor: Colors.white,
      ),
      body: SingleChildScrollView(
        padding: const EdgeInsets.all(20),
        child: Form(
          key: formKey,
          child: Column(
            crossAxisAlignment: CrossAxisAlignment.stretch,
            children: [
              // Foto do EPI
              ClipRRect(
                borderRadius: BorderRadius.circular(12),
                child: Image.network(
                  '${ApiConfig.baseUrl}${epi.imagemUrl}',
                  height: 200,
                  fit: BoxFit.contain,
                  errorBuilder: (context, error, stackTrace) {
                    return Container(
                      height: 200,
                      color: Colors.blue.shade50,
                      child: const Icon(
                        Icons.health_and_safety,
                        size: 80,
                        color: Colors.blue,
                      ),
                    );
                  },
                ),
              ),
              const SizedBox(height: 20),

              // Dados do EPI
              Text(
                epi.nome,
                style: const TextStyle(
                  fontSize: 22,
                  fontWeight: FontWeight.bold,
                ),
              ),
              const SizedBox(height: 6),
              Text(
                epi.categoria,
                style: const TextStyle(fontSize: 16, color: Colors.grey),
              ),
              const Divider(height: 30),
              linhaInfo(Icons.verified, 'CA', epi.ca),
              linhaInfo(
                Icons.event,
                'Validade do CA',
                epi.validadeFormatada,
                cor: epi.caVencido ? Colors.red : null,
              ),
              if (widget.usuario.perfil.trim().toUpperCase() == 'ADMIN')
                linhaInfo(
                  Icons.inventory_2,
                  'Disponível',
                  '${epi.quantidadeDisponivel} un.',
                ),
              const Divider(height: 30),

              // Formulário de solicitação
              Text(
                'Solicitante: ${widget.usuario.nome} '
                '(matricula ${widget.usuario.matricula})',
              ),
              const SizedBox(height: 16),
              TextFormField(
                controller: observacaoController,
                maxLines: 3,
                maxLength: 200,
                decoration: const InputDecoration(
                  labelText: 'Motivo da solicitação',
                  hintText: 'Ex .: capacete atual esta trincado',
                  border: OutlineInputBorder(),
                ),
                validator: (valor) {
                  if (valor == null || valor.trim().isEmpty) {
                    return 'Informe o motivo da solicitação';
                  }
                  if (valor.trim().length < 5) {
                    return 'Escreva pelo menos 5 caracteres';
                  }
                  return null; // null = campo válido
                },
              ),
              const SizedBox(height: 8),

              // Aviso quando o EPI não pode ser emprestado
              if (!podeSolicitar)
                Padding(
                  padding: const EdgeInsets.only(bottom: 8),
                  child: Text(
                    epi.caVencido
                        ? 'CA vencido: este EPI não pode ser emprestado.'
                        : 'EPI sem estoque no momento.',
                    textAlign: TextAlign.center,
                    style: const TextStyle(
                      color: Colors.red,
                      fontWeight: FontWeight.bold,
                    ),
                  ),
                ),
              // Botão Solicitar Empréstimo
              SizedBox(
                height: 50,
                child: ElevatedButton.icon(
                  onPressed: (carregando || !podeSolicitar)
                      ? null
                      : solicitarEmprestimo,
                  icon: carregando
                      ? const SizedBox(
                          width: 20,
                          height: 20,
                          child: CircularProgressIndicator(
                            strokeWidth: 2,
                            color: Colors.white,
                          ),
                        )
                      : const Icon(Icons.send),
                  label: const Text('Solicitar Emprestimo'),
                  style: ElevatedButton.styleFrom(
                    backgroundColor: Colors.blue,
                    foregroundColor: Colors.white,
                  ),
                ),
              ),
            ],
          ),
        ),
      ),
    );
  }

  // Monta uma linha "icone + rotulo + valor"
  Widget linhaInfo(IconData icone, String rotulo, String valor, {Color? cor}) {
    return Padding(
      padding: const EdgeInsets.symmetric(vertical: 6),
      child: Row(
        children: [
          Icon(icone, color: cor ?? Colors.blue),
          const SizedBox(width: 10),
          Text(
            '$rotulo: ',
            style: const TextStyle(fontWeight: FontWeight.bold),
          ),
          Expanded(
            child: Text(valor, style: TextStyle(color: cor)),
          ),
        ],
      ),
    );
  }
}
</file>

<file path="lib/src/screens/epi_screen.dart">
import 'package:flutter/material.dart';

import '../models/epi.dart';
import '../models/emprestimo.dart';
import '../models/usuario.dart';
import '../services/api_config.dart';
import '../services/epi_service.dart';
import '../services/emprestimo_service.dart';
import 'epi_detalhe_screen.dart';

class EpiScreen extends StatefulWidget {
  final Usuario usuario;
  final bool apenasCaVencidos;
  final bool apenasEstoqueBaixo;
  const EpiScreen({
    super.key,
    required this.usuario,
    this.apenasCaVencidos = false,
    this.apenasEstoqueBaixo = false,
  });
  @override
  State<EpiScreen> createState() => _EpiScreenState();
}

class _EpiScreenState extends State<EpiScreen> {
  late Future<void> dados;
  List<Epi> epis = [];
  Map<int, int> emPosse = {};
  bool get admin => widget.usuario.perfil.trim().toUpperCase() == 'ADMIN';
  @override
  void initState() {
    super.initState();
    dados = carregar();
  }

  Future<void> carregar() async {
    final resultados = await Future.wait<Object>([
      EpiService().buscarEpis(),
      if (!admin) EmprestimoService().buscarPorFuncionario(widget.usuario.id),
    ]);
    epis = resultados[0] as List<Epi>;
    emPosse = {};
    if (!admin) {
      // Um registro de empréstimo ativo representa uma unidade em posse.
      for (final emprestimo in resultados[1] as List<Emprestimo>) {
        if (emprestimo.status.toUpperCase() == 'EMPRESTADO') {
          final id = emprestimo.epi.id;
          emPosse.update(id, (n) => n + 1, ifAbsent: () => 1);
        }
      }
    }
  }

  Future<void> atualizar() async {
    final futuro = carregar();
    setState(() {
      dados = futuro;
    });
    try {
      await futuro;
    } catch (_) {
      /* O FutureBuilder apresenta o erro. */
    }
  }

  Future<void> abrir(Epi epi) async {
    await Navigator.of(context).push(
      MaterialPageRoute<void>(
        builder: (_) => EpiDetalheScreen(epi: epi, usuario: widget.usuario),
      ),
    );
    if (mounted) await atualizar();
  }

  Widget card(Epi epi, {bool posse = false}) => Card(
    color: epi.caVencido ? Colors.red.shade50 : null,
    child: ListTile(
      onTap: () => abrir(epi),
      leading: Image.network(
        '${ApiConfig.baseUrl}${epi.imagemUrl}',
        width: 50,
        height: 50,
        fit: BoxFit.cover,
        errorBuilder: (_, _, _) =>
            const Icon(Icons.health_and_safety, size: 40, color: Colors.blue),
      ),
      title: Text(
        epi.nome,
        style: const TextStyle(fontWeight: FontWeight.bold),
      ),
      subtitle: Column(
        crossAxisAlignment: CrossAxisAlignment.start,
        children: [
          Text(epi.categoria),
          Text(
            'CA: ${epi.ca} • ${epi.caVencido ? 'Vencido em' : 'Válido até'} ${epi.validadeFormatada}',
            style: TextStyle(color: epi.caVencido ? Colors.red : null),
          ),
          if (admin) Text('Disponível: ${epi.quantidadeDisponivel} un.'),
          if (!admin && (emPosse[epi.id] ?? 0) > 0)
            Text(
              'Em sua posse: ${emPosse[epi.id]} un.',
              style: const TextStyle(fontWeight: FontWeight.bold),
            ),
          if (!posse) const Text('Toque para consultar e solicitar'),
        ],
      ),
      trailing: epi.caVencido
          ? const Icon(Icons.warning_amber_rounded, color: Colors.red)
          : null,
    ),
  );

  @override
  Widget build(BuildContext context) => Scaffold(
    appBar: AppBar(
      title: Text(admin ? 'Lista de EPIs' : 'EPIs da empresa e meus EPIs'),
      backgroundColor: Colors.blue,
      foregroundColor: Colors.white,
    ),
    body: FutureBuilder<void>(
      future: dados,
      builder: (context, snapshot) {
        if (snapshot.connectionState == ConnectionState.waiting) {
          return const Center(child: CircularProgressIndicator());
        }
        if (snapshot.hasError) {
          return Center(
            child: ElevatedButton(
              onPressed: atualizar,
              child: const Text('Falha ao carregar EPIs. Tentar novamente'),
            ),
          );
        }
        final filtrados = epis
            .where(
              (epi) =>
                  (!widget.apenasCaVencidos || epi.caVencido) &&
                  (!widget.apenasEstoqueBaixo || epi.quantidadeDisponivel <= 2),
            )
            .toList();
        final possuidos = epis
            .where((epi) => (emPosse[epi.id] ?? 0) > 0)
            .toList();
        return RefreshIndicator(
          onRefresh: atualizar,
          child: ListView(
            physics: const AlwaysScrollableScrollPhysics(),
            padding: const EdgeInsets.all(16),
            children: [
              if (!admin) ...[
                Text(
                  'Meus EPIs em posse',
                  style: Theme.of(context).textTheme.titleLarge,
                ),
                const SizedBox(height: 8),
                if (possuidos.isEmpty)
                  const ListTile(title: Text('Você não possui EPIs em posse.')),
                for (final epi in possuidos) card(epi, posse: true),
                const SizedBox(height: 24),
                Text(
                  'EPIs fornecidos pela empresa',
                  style: Theme.of(context).textTheme.titleLarge,
                ),
                const SizedBox(height: 8),
              ],
              if (filtrados.isEmpty)
                const ListTile(title: Text('Nenhum EPI cadastrado.')),
              for (final epi in filtrados) card(epi),
            ],
          ),
        );
      },
    ),
  );
}
</file>

