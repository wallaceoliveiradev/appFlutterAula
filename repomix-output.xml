import 'package:flutter/material.dart';

import '../models/emprestimo.dart';
import '../models/usuario.dart';
import '../services/emprestimo_service.dart';

class MeusEmprestimosScreen extends StatefulWidget {
  final Usuario usuario;

  const MeusEmprestimosScreen({super.key, required this.usuario});

  @override
  State<MeusEmprestimosScreen> createState() => _MeusEmprestimosScreenState();
}

class _MeusEmprestimosScreenState extends State<MeusEmprestimosScreen> {
  late Future<List<Emprestimo>> emprestimosFuture;

  @override
  void initState() {
    super.initState();
    emprestimosFuture =
        EmprestimoService().buscarPorFuncionario(widget.usuario.id);
  }

  Future<void> atualizar() async {
    setState(() {
      emprestimosFuture =
          EmprestimoService().buscarPorFuncionario(widget.usuario.id);
    });
    await emprestimosFuture;
  }

  @override
  Widget build(BuildContext context) {
    return Scaffold(
      appBar: AppBar(
        title: const Text('Meus Empréstimos'),
        backgroundColor: Colors.blue,
        foregroundColor: Colors.white,
      ),
      body: FutureBuilder<List<Emprestimo>>(
        future: emprestimosFuture,
        builder: (context, snapshot) {
          if (snapshot.connectionState == ConnectionState.waiting) {
            return const Center(child: CircularProgressIndicator());
          }

          if (snapshot.hasError) {
            return Center(
              child: Padding(
                padding: const EdgeInsets.all(24),
                child: Column(
                  mainAxisSize: MainAxisSize.min,
                  children: [
                    const Text('Não foi possível carregar seus empréstimos.'),
                    const SizedBox(height: 12),
                    ElevatedButton.icon(
                      onPressed: atualizar,
                      icon: const Icon(Icons.refresh),
                      label: const Text('Tentar novamente'),
                    ),
                  ],
                ),
              ),
            );
          }

          final emprestimos = snapshot.data ?? [];
          if (emprestimos.isEmpty) {
            return RefreshIndicator(
              onRefresh: atualizar,
              child: ListView(
                children: const [
                  SizedBox(height: 180),
                  Center(child: Text('Você ainda não possui empréstimos.')),
                ],
              ),
            );
          }

          return RefreshIndicator(
            onRefresh: atualizar,
            child: ListView.separated(
              padding: const EdgeInsets.all(16),
              itemCount: emprestimos.length,
              separatorBuilder: (_, _) => const SizedBox(height: 12),
              itemBuilder: (context, index) {
                return _EmprestimoCard(emprestimo: emprestimos[index]);
              },
            ),
          );
        },
      ),
    );
  }
}

class _EmprestimoCard extends StatelessWidget {
  final Emprestimo emprestimo;

  const _EmprestimoCard({required this.emprestimo});

  @override
  Widget build(BuildContext context) {
    final statusColor = _statusColor(emprestimo.status);
    final data = emprestimo.dataEmprestimo;
    final dataFormatada =
        '${data.day.toString().padLeft(2, '0')}/${data.month.toString().padLeft(2, '0')}/${data.year}';

    return Card(
      child: Padding(
        padding: const EdgeInsets.all(16),
        child: Column(
          crossAxisAlignment: CrossAxisAlignment.start,
          children: [
            Row(
              crossAxisAlignment: CrossAxisAlignment.start,
              children: [
                Expanded(
                  child: Text(
                    emprestimo.epi.nome,
                    style: const TextStyle(
                      fontSize: 18,
                      fontWeight: FontWeight.bold,
                    ),
                  ),
                ),
                const SizedBox(width: 8),
                Chip(
                  label: Text(
                    emprestimo.status,
                    style: const TextStyle(color: Colors.white),
                  ),
                  backgroundColor: statusColor,
                ),
              ],
            ),
            const SizedBox(height: 10),
            Text('Data da solicitação: $dataFormatada'),
            const SizedBox(height: 6),
            Text('Motivo: ${emprestimo.observacao}'),
          ],
        ),
      ),
    );
  }

  Color _statusColor(String status) {
    switch (status.toUpperCase()) {
      case 'SOLICITADO':
        return Colors.orange;
      case 'EMPRESTADO':
        return Colors.green;
      case 'DEVOLVIDO':
        return Colors.grey;
      default:
        return Colors.blueGrey;
    }
  }
}
</file>

<file path="lib/src/screens/solicitacoes_screen.dart">
import 'package:flutter/material.dart';

import '../models/emprestimo.dart';
import '../models/usuario.dart';
import '../services/emprestimo_service.dart';

class SolicitacoesScreen extends StatefulWidget {
  final Usuario usuario;
  final String statusInicial;
  const SolicitacoesScreen({
    super.key,
    required this.usuario,
    this.statusInicial = 'SOLICITADO',
  });
  @override
  State<SolicitacoesScreen> createState() => _SolicitacoesScreenState();
}

class _SolicitacoesScreenState extends State<SolicitacoesScreen> {
  late Future<List<Emprestimo>> dados;
  late String status;
  int? processando;
  @override
  void initState() {
    super.initState();
    status = widget.statusInicial;
    if (widget.usuario.perfil.trim().toUpperCase() == 'ADMIN') {
      dados = carregar();
    }
  }

  Future<List<Emprestimo>> carregar() =>
      EmprestimoService().buscarTodos(widget.usuario.id);
  Future<void> atualizar() async {
    final futuro = carregar();
    setState(() {
      dados = futuro;
    });
    try {
      await futuro;
    } catch (_) {
      /* O FutureBuilder mostra a falha. */
    }
  }

  Future<void> movimentar(Emprestimo e) async {
    final devolver = e.status == 'EMPRESTADO';
    final confirmou = await showDialog<bool>(
      context: context,
      builder: (context) => AlertDialog(
        title: Text(devolver ? 'Registrar devolução' : 'Aprovar solicitação'),
        content: Text(
          '${devolver ? 'Confirmar a devolução' : 'Confirmar a entrega'} de ${e.epi.nome} para ${e.funcionarioNome ?? 'o funcionário'}?',
        ),
        actions: [
          TextButton(
            onPressed: () => Navigator.pop(context, false),
            child: const Text('Cancelar'),
          ),
          FilledButton(
            onPressed: () => Navigator.pop(context, true),
            child: const Text('Confirmar'),
          ),
        ],
      ),
    );
    if (confirmou != true || !mounted) return;
    setState(() {
      processando = e.id;
    });
    try {
      await EmprestimoService().movimentar(
        e.id,
        widget.usuario.id,
        devolver: devolver,
      );
      if (!mounted) return;
      ScaffoldMessenger.of(context).showSnackBar(
        SnackBar(
          content: Text(
            devolver ? 'Devolução registrada.' : 'Solicitação aprovada.',
          ),
        ),
      );
      await atualizar();
    } catch (erro) {
      if (mounted) {
        ScaffoldMessenger.of(context).showSnackBar(
          SnackBar(
            content: Text(erro.toString().replaceFirst('Exception: ', '')),
          ),
        );
      }
    } finally {
      if (mounted) {
        setState(() {
          processando = null;
        });
      }
    }
  }

  @override
  Widget build(BuildContext context) {
    if (widget.usuario.perfil.trim().toUpperCase() != 'ADMIN') {
      return Scaffold(
        appBar: AppBar(title: const Text('Acesso restrito')),
        body: const Center(
          child: Text('Apenas administradores podem gerenciar solicitações.'),
        ),
      );
    }
    return Scaffold(
      appBar: AppBar(title: const Text('Solicitações e empréstimos')),
      body: Column(
        children: [
          Padding(
            padding: const EdgeInsets.all(16),
            child: DropdownButtonFormField<String>(
              initialValue: status,
              decoration: const InputDecoration(
                labelText: 'Status',
                border: OutlineInputBorder(),
              ),
              items: const [
                DropdownMenuItem(
                  value: 'SOLICITADO',
                  child: Text('Solicitações pendentes'),
                ),
                DropdownMenuItem(
                  value: 'EMPRESTADO',
                  child: Text('EPIs emprestados'),
                ),
                DropdownMenuItem(
                  value: 'DEVOLVIDO',
                  child: Text('EPIs devolvidos'),
                ),
              ],
              onChanged: (valor) {
                if (valor != null) {
                  setState(() {
                    status = valor;
                  });
                }
              },
            ),
          ),
          Expanded(
            child: FutureBuilder<List<Emprestimo>>(
              future: dados,
              builder: (context, snapshot) {
                if (snapshot.connectionState == ConnectionState.waiting) {
                  return const Center(child: CircularProgressIndicator());
                }
                if (snapshot.hasError) {
                  return Center(
                    child: ElevatedButton(
                      onPressed: atualizar,
                      child: const Text('Falha ao carregar. Tentar novamente'),
                    ),
                  );
                }
                final itens = snapshot.requireData
                    .where((e) => e.status == status)
                    .toList();
                return RefreshIndicator(
                  onRefresh: atualizar,
                  child: ListView(
                    physics: const AlwaysScrollableScrollPhysics(),
                    padding: const EdgeInsets.all(16),
                    children: itens.isEmpty
                        ? [
                            const ListTile(
                              title: Text('Nenhum registro neste status.'),
                            ),
                          ]
                        : [
                            for (final e in itens)
                              Card(
                                child: Padding(
                                  padding: const EdgeInsets.all(16),
                                  child: Column(
                                    crossAxisAlignment:
                                        CrossAxisAlignment.start,
                                    children: [
                                      Text(
                                        e.epi.nome,
                                        style: Theme.of(context)
                                            .textTheme
                                            .titleMedium,
                                      ),
                                      Text(
                                        'Funcionário: ${e.funcionarioNome ?? 'Não informado'}',
                                      ),
                                      Text('Status: ${e.status}'),
                                      if (e.observacao.isNotEmpty)
                                        Text('Motivo: ${e.observacao}'),
                                      if (e.status != 'DEVOLVIDO')
                                        Align(
                                          alignment: Alignment.centerRight,
                                          child: FilledButton.icon(
                                            onPressed: processando == null
                                                ? () => movimentar(e)
                                                : null,
                                            icon: Icon(
                                              e.status == 'SOLICITADO'
                                                  ? Icons.check
                                                  : Icons.assignment_return,
                                            ),
                                            label: Text(
                                              e.status == 'SOLICITADO'
                                                  ? 'Aprovar'
                                                  : 'Registrar devolução',
                                            ),
                                          ),
                                        ),
                                    ],
                                  ),
                                ),
                              ),
                          ],
                  ),
                );
              },
            ),
          ),
        ],
      ),
    );
  }
